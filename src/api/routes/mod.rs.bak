use axum::{
    middleware,
    routing::{delete, get, post},
    Router,
};
use std::sync::Arc;

use crate::api::handlers;
use crate::domain::repositories::ApiKeyRepository;
use crate::domain::services::{AccountService, TransactionService, WebhookService};
use crate::infrastructure::rate_limiter::RateLimiter;
use crate::middleware::auth::auth_middleware;
use crate::middleware::rate_limit::rate_limit_middleware;

#[derive(Clone)]
pub struct AppState {
    pub account_service: Arc<AccountService>,
    pub transaction_service: Arc<TransactionService>,
    pub webhook_service: Arc<WebhookService>,
    pub api_key_repo: Arc<dyn ApiKeyRepository>,
    pub rate_limiter: Arc<RateLimiter>,
}

pub fn create_router(
    account_service: Arc<AccountService>,
    transaction_service: Arc<TransactionService>,
    webhook_service: Arc<WebhookService>,
    api_key_repo: Arc<dyn ApiKeyRepository>,
    rate_limiter: Arc<RateLimiter>,
) -> Router {
    let state = AppState {
        account_service,
        transaction_service,
        webhook_service,
        api_key_repo: api_key_repo.clone(),
        rate_limiter: rate_limiter.clone(),
    };

    // Public routes
    let public_routes = Router::new()
        .route("/health", get(handlers::health_check))
        .route("/api/v1/accounts", post(handlers::create_account));

    // Protected routes with authentication and rate limiting
    let protected_routes = Router::new()
        .route("/api/v1/accounts/me", get(handlers::get_account))
        .route("/api/v1/accounts/me/balance", get(handlers::get_account_balance))
        .route("/api/v1/transactions/credit", post(handlers::create_credit))
        .route("/api/v1/transactions/debit", post(handlers::create_debit))
        .route("/api/v1/transactions/transfer", post(handlers::create_transfer))
        .route("/api/v1/transactions/:id", get(handlers::get_transaction))
        .route("/api/v1/transactions", get(handlers::list_transactions))
        .route("/api/v1/webhooks", post(handlers::create_webhook))
        .route("/api/v1/webhooks", get(handlers::list_webhooks))
        .route("/api/v1/webhooks/:id", delete(handlers::delete_webhook))
        .layer(middleware::from_fn_with_state(
            api_key_repo.clone(),
            auth_middleware,
        ))
        .layer(middleware::from_fn_with_state(
            rate_limiter.clone(),
            rate_limit_middleware,
        ));

    // Combine routes
    Router::new()
        .merge(public_routes)
        .merge(protected_routes)
        .with_state(state)
}
